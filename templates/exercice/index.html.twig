{% extends 'base.html.twig' %}

{% block title %}Exercice{% endblock %}

{% block body %}
    <main class="contenu">
        <a class="retour" href="{{ path('app_groupement') }}">Tous les groupements</a>
 
        <div class="tete-page">
            <div>
                <h1>{{ groupementExerciceListDto.nom }}</h1>
                <dl class="coordonnees">
                    <div>
                        <dt>Téléphone</dt>
                        <dd>{{ groupementExerciceListDto.tel }}</dd>
                    </div>
                    <div>
                        <dt>Adresse</dt>
                        <dd>{{ groupementExerciceListDto.adresse }}</dd>
                    </div>
                </dl>
            </div>
            <div class="groupe-boutons">
                <button class="bouton bouton--secondaire" type="button" disabled title="Écran prévu avec la validation des formulaires">Modifier</button>
                <button class="bouton" type="button" disabled>Ouvrir un exercice</button>
            </div>
        </div>
 
        <section class="panneau" aria-labelledby="titre-exercice">
            <div class="entete-panneau">
                <div>
                    <h2 id="titre-exercice">Exercice en cours</h2>
                    <p class="sous-titre">
                        {% if groupementExerciceListDto.exerciceEncours %}
                            Du {{ groupementExerciceListDto.exerciceEncours.dateDebut|format_date('long') }}
                            au {{ groupementExerciceListDto.exerciceEncours.dateFin|format_date('long') }}
                        {% else %}
                            Aucun exercice en cours
                        {% endif %}
                    </p>
                </div>
                <button class="bouton bouton--secondaire" type="button">Clôturer l’exercice</button>
            </div>
 
            <ol class="frise">
                {% for etape in groupementExerciceListDto.etapes %}
                    <li class="{{ etape.classe }}">
                        <span class="etape__nom">{{ etape.nom }}</span>
                        <span class="etape__date">
                            {{ etape.date ? etape.date|format_date('long') : 'Date à fixer' }}
                        </span>
                        {% if etape.note %}
                            <span class="etape__note">{{ etape.note }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>
 
        <section class="panneau" aria-labelledby="titre-historique">
            <div class="entete-panneau">
                <h2 id="titre-historique">Historique des exercices</h2>
            </div>
            <div class="defilement">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Période</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Rétribution</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for exercice in groupementExerciceListDto.exercices %}
                            <tr>
                                <td>
                                    {{ exercice.dateDebut|format_date('long') }}
                                    –
                                    {{ exercice.dateFin ? exercice.dateFin|format_date('long') : 'en cours' }}
                                </td>
                                <td><span class="statut {{ exercice.classeStatut }}">{{ exercice.statut }}</span></td>
                                <td>
                                    {{ exercice.dateRetribution ? exercice.dateRetribution|format_date('long') : '—' }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3">Aucun exercice enregistré pour ce groupement.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>
 
{% endblock %}
